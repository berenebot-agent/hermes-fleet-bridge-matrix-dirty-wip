PUBLIC_URL=https://chat.example.com
MATRIX_SERVER_NAME=chat.example.com
ADMIN_USERNAME=admin
# Use a unique strong password of at least 16 characters. Never commit .env.
ADMIN_PASSWORD=
HFB_UID=1000
HFB_GID=1000
# Set to: stat -c %g /var/run/docker.sock
DOCKER_GID=0
LISTEN_ADDR=0.0.0.0:8088
MATRIX_LISTEN_ADDR=127.0.0.1:18008
HERMES_DIRS=
# Optional JSON: {"iris":{"service":"hermes","network":"iris_default","port":8642}}
# Host-network agents need distinct API ports, and must not publish those ports publicly.
HERMES_OVERRIDES={}
IDLE_TIMEOUT=15m
START_TIMEOUT=120s
MAX_PARALLEL_RUNS=4
