PUBLIC_URL=https://chat.example.com
# Durable Matrix identity: keep this unchanged when moving PUBLIC_URL to another host.
MATRIX_SERVER_NAME=chat.example.com
ADMIN_USERNAME=admin
# Lowercased automatically; must be outside the reserved agent_ namespace.
# Use a unique strong password of at least 16 characters. Never commit .env.
# Changing this updates the existing administrator at startup and logs out its devices.
ADMIN_PASSWORD=
HFB_UID=1000
HFB_GID=1000
# Set to: stat -c %g /var/run/docker.sock
DOCKER_GID=0
LISTEN_ADDR=0.0.0.0:8088
MATRIX_LISTEN_ADDR=127.0.0.1:18008
# Agents are automatically discovered from immediate directories under FLEET_DIR.
# Optional JSON: {"iris":{"service":"hermes","network":"iris_default","port":8642}}
# Existing data/.env API ports are recovered; host-network agents need distinct ports.
# Never publish Hermes API ports publicly.
HERMES_OVERRIDES={}
IDLE_TIMEOUT=15m
START_TIMEOUT=120s
MAX_PARALLEL_RUNS=4

# Fleet management is enabled by the default Compose file. See docs/fleet.md.
# Defaults: $PWD/data/fleet and $PWD/data/templates (run Compose from the install dir).
# Pre-create data/fleet and data/templates as HFB_UID. Override with absolute host paths:
# FLEET_DIR=/opt/hermes-matrix/data/fleet
# FLEET_TEMPLATE_DIR=/opt/hermes-matrix/data/templates
