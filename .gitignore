# Persistent runtime state (bind-mounted at /data). Never commit: it holds the
# Matrix homeserver database, controller state, sync tokens and queued turns.
data/

# Secrets — real credentials only; the template is tracked.
.env

# Local build artifacts and data backups. Zip archives here are release
# bundles or ./data backups (large, and backups contain chat state).
*.zip
hermes-fleet-bridge-matrix

# Test logs (gitignored, persistent across runs).
tests/logs/
